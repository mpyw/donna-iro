# 出力の解像度を固定する。kanshi は labwc の autostart で動いている。
#
# **4K に上げさせない。** minifb は 1280x720 のバッファを CPU で拡大するので、
# 3840x2160 だと 1フレーム 829万画素 × 30fps ≒ 毎秒2.5億画素になり、ほぼ
# 1コアを食い切る（実測 90%）。whisper は4コア全部欲しいので、そのぶんが
# 認識時間に乗る。**4K で得るのは丸の縁が滑らかになることだけ。**
#
# 1920x1080 なら画素は 1/4。アプリは 1280x720 を
# ScaleMode::AspectRatioStretch で伸ばすので、どちらでも絵は同じに収まる。
#
# 速度は書かない。**書くと、その値を持たない表示機に差し替えたとき適用が
# 落ちる。** 番号ではなくコネクタ名で指しているのも同じ理由。
#
# 直したら kanshi を入れ直す（このビルドには reload が無い）。
# tools/build-pi.sh が配るときにやる。

profile tv {
    output HDMI-A-1 mode 1920x1080 position 0,0
}

# 隣のポートに差したときのぶん。kanshi は「繋がっている出力の集合」で
# プロファイルを選ぶので、両方ぶん書いておかないと片方で何も当たらない。
profile tv2 {
    output HDMI-A-2 mode 1920x1080 position 0,0
}
